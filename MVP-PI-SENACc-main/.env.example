# ============================================================
# BookClub Hub - Environment Variables Example
# Copy this file to .env and fill in your values.
# Never commit the real .env file.
# ============================================================

# --- PostgreSQL Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bookclub_hub
DATABASE_USER=bookclub
DATABASE_PASSWORD=bookclub_secret

# --- Backend (Flask) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
FLASK_DEBUG=true

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:5000/api
